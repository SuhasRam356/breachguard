{
  "manifest_version": 3,
  "name": "BreachGuard Sentinel",
  "version": "1.0",
  "description": "Actively monitors password inputs and checks against known data breaches.",
  "permissions": [
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
